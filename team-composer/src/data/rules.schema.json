{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rules Schema",
  "description": "Schema for team-composer/src/data/rules.json",
  "type": "object",
  "required": [
    "budget",
    "maxPiecesTotal",
    "kingSigla",
    "maxIdenticalDefault",
    "maxIdenticalByCategory",
    "maxCountByCategory"
  ],
  "properties": {
    "budget": {
      "type": "integer",
      "minimum": 0
    },
    "maxPiecesTotal": {
      "type": "integer",
      "minimum": 0
    },
    "kingSigla": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}$"
    },
    "maxIdenticalDefault": {
      "type": "integer",
      "minimum": 1
    },
    "maxIdenticalByCategory": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "maxCountByCategory": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    }
  },
  "additionalProperties": false
}
